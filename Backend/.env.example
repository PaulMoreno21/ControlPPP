# Plantilla para ejecutar el Backend fuera de Docker, desde Contro_PPP_Backend.
# Copiar a .env, completar los valores y no subir .env a Git.
# Docker Compose no usa este archivo: configura conexión y secretos por separado.
# Sintaxis de propiedades: valores sin comillas de shell.

# Oracle accesible desde el proceso Java; el esquema debe estar instalado.
ORACLE_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=CTRLPPP
ORACLE_PASSWORD=

# Obligatorio: clave aleatoria Base64 que represente al menos 32 bytes.
# Generar una distinta por entorno; consultar README. No usar una contraseña aquí.
APP_JWT_SECRET_BASE64=

# Solo desarrollo local por HTTP. En HTTPS y en servidor debe ser true.
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_MAX_ACTIVE=50000
# Cierre por inactividad: 15 minutos. Duración máxima desde el login: 8 horas.
# La inactividad debe ser menor o igual que la duración máxima.
APP_SESSION_IDLE_TIMEOUT_SECONDS=900
APP_SESSION_MAX_DURATION_SECONDS=28800

# Límites por ventana, en segundos.
RATE_LIMIT_IP_REQUESTS=300
RATE_LIMIT_USER_REQUESTS=120
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=50000
# Vacío para acceso directo; solo direcciones exactas de proxies controlados.
RATE_LIMIT_TRUSTED_PROXY_IPS=

# Integración institucional pendiente de configuración/aprobación.
OAUTH_IDENTITY_CLAIM=email

# Precarga una vez por año. Requiere clave propia y ADMIN_GENERAL global activo.
APP_HOLIDAY_SYNC_ENABLED=true
FERIADOS_API_KEY=
APP_HOLIDAY_SYNC_ADMIN_ID=0
APP_HOLIDAY_SYNC_CRON=0 15 3 1 1 *
